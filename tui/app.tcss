Screen {
background: #1e1e1e;
}

DataTable {
height: 100%;
border: solid #333333;
}

DataTable > .datatable--header {
text-style: bold;
background: #2d2d2d;
color: #00ffff;
}

.status-on {
color: #00ff00;
text-style: bold;
}

.status-off {
color: #ff0000;
text-style: bold;
}

.targeting-rule {
color: #aaaaaa;
text-style: italic;
}

.modal-dialog {
    align: center middle;
    background: $surface;
    padding: 1 2;
    border: solid $primary;
    width: 60; /* Optional: Sets a fixed width for the popup */
    height: auto; /* Optional: Lets the box shrink to fit the form contents */
}